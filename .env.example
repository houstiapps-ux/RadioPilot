# Public hostname Caddy serves and requests a certificate for.
SITE_ADDRESS=radiopilot.example.com

# Credentials for the /debug/* routes.
# Generate the hash with: ./scripts/hash-debug-password.sh
DEBUG_USER=radiopilot
DEBUG_PASSWORD_HASH=

# Station identity. HOME_GRID drives the worker's snapshot; PSK_REFERENCE_GRID
# is the grid all directional propagation is measured from. Set both to your
# own locator.
HOME_GRID=
PSK_REFERENCE_GRID=

# Spot source: "dxheat" (HTTP polling, no credentials) or "telnet" (DX cluster).
# DX_CLUSTER_CALLSIGN is required for telnet and must be your own callsign.
SPOT_SOURCE=dxheat
DX_CLUSTER_CALLSIGN=

LOG_LEVEL=info

# Resource ceilings. Raise REDIS_MAXMEMORY if you widen the retention windows.
REDIS_MAXMEMORY=256mb
WORKER_MEM_LIMIT=512m
